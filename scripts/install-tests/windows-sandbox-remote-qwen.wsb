<Configuration>
  <Networking>Enable</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -Command "Write-Host '[ra-h] Testing install.ps1 (remote, main branch, qwen-local profile) in Windows Sandbox' -ForegroundColor Green; Write-Host '[ra-h] This downloads portable Ollama and pulls ~3 GB of models — be patient.' -ForegroundColor Yellow; Set-Location $env:USERPROFILE; $b = Join-Path $env:TEMP 'sandbox-bootstrap.ps1'; Invoke-WebRequest -UseBasicParsing https://raw.githubusercontent.com/bradwmorris/ra-h_os/main/scripts/install-tests/sandbox-bootstrap.ps1 -OutFile $b; powershell.exe -ExecutionPolicy Bypass -File $b -Mode remote -Ref main -AiProfile qwen-local"</Command>
  </LogonCommand>
</Configuration>
